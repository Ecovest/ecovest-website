# EcoVest landing page: environment variables
# Copy this file to .env.local for local work, and add the same keys in your
# hosting dashboard (Vercel / Netlify → Project → Settings → Environment Variables).
# Never commit real values: .env and .env*.local are git-ignored.

# Public address of the live site. Used to build absolute URLs for
# social share images (Open Graph / X cards) and canonical links.
# Optional: defaults to https://ecovest.community when unset.
NEXT_PUBLIC_SITE_URL=https://ecovest.community

# Google Gemini API key for the EcoBot chatbot from the previous site.
# The current landing page doesn't call it, so it's optional. Existing
# deployments can keep it set; it will be used again when EcoBot returns.
# Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
