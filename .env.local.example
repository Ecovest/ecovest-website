# Google Gemini API key — required for the EcoBot chatbot
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — defaults to gemini-2.5-flash (verified working).
# Other options (depending on your key access):
#   gemini-2.5-pro       — smarter, slower, more expensive
#   gemini-2.5-flash-lite — cheaper, lighter
# Note: gemini-1.5-* and gemini-2.0-* are deprecated for new keys.
# GEMINI_MODEL=gemini-2.5-flash

# Optional — set to 1 to log every Gemini event to the server console.
# CHAT_DEBUG=1
